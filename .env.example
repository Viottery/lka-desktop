# Frontend local service; copy to .env before first launch.
# Separate LKA backend configuration lives in the backend repository.
APP_ENV=dev
DEBUG=false
LOCAL_RAG_ENABLED=false
SHELL_RUNTIME_ENABLED=false
QDRANT_MODE=disabled
LKA_BACKEND_URL=http://127.0.0.1:8765
LKA_MESSAGES_API_TOKEN=
# Default per-session workspace: Windows Documents/Local Knowledge Agent/Workspaces.
# LKA_SESSION_WORKSPACE_BASE=C:/Workspaces/LKA
# Optional QQ plugin: merge .env.qq-reader.example and fill credentials locally.
QQ_READER_ENABLED=false
QQ_MESSAGING_ENABLED=false
QQ_SEND_ENABLED=false

# Remote workbench uses the frontend's existing port; enable only trusted entries.
# Semicolon-separated full origins; empty keeps remote API access disabled.
# LKA_WORKBENCH_ORIGINS=http://your-computer.your-tailnet.ts.net:8780
# Fixed loopback LKA upstream, default http://127.0.0.1:8765 (ports 80/8765 only).
# LKA_WORKBENCH_BACKEND_URL=http://127.0.0.1:8765
# Remote workspace creation defaults to LKA_SESSION_WORKSPACE_BASE/Documents.
# Optional additional exact parent directories; semicolon separated.
# LKA_REMOTE_WORKSPACE_ROOTS=D:/Workspaces/LKA
