# Frontend local service; copy to .env before first launch.
# Separate LKA backend configuration lives in the backend repository.
APP_ENV=dev
DEBUG=false
LOCAL_RAG_ENABLED=false
SHELL_RUNTIME_ENABLED=false
QDRANT_MODE=disabled
LKA_BACKEND_URL=http://127.0.0.1:8765
LKA_MESSAGES_API_TOKEN=
# Default per-session workspace: Windows Documents/Local Knowledge Agent/Workspaces.
# LKA_SESSION_WORKSPACE_BASE=C:/Workspaces/LKA
# Optional QQ plugin: merge .env.qq-reader.example and fill credentials locally.
QQ_READER_ENABLED=false
QQ_MESSAGING_ENABLED=false
QQ_SEND_ENABLED=false
