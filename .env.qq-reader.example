# Merge into the private .env loaded by run-native-local.ps1. Never put tokens in JS.
QQ_READER_ENABLED=false
QQ_WS_URL=ws://127.0.0.1:3001/event
QQ_WS_TOKEN=
# Confirm the target account in QQ before filling this. No auto-selection.
QQ_EXPECTED_SELF_ID=
QQ_DB_PATH=data/qq/reader.db
QQ_STORE_RAW_EVENT=false
# Proposed backend API: leave blank until implemented and agreed.
QQ_SYNC_URL=
QQ_SYNC_TOKEN=
QQ_MEDIA_ENABLED=false
QQ_MEDIA_CACHE_DIR=data/qq/media
QQ_MEDIA_TTL_SECONDS=259200
QQ_MEDIA_MAX_BYTES=2147483648
QQ_MEDIA_IMAGE_MAX_BYTES=20971520
QQ_MEDIA_VIDEO_MAX_BYTES=209715200
QQ_MEDIA_DOWNLOAD_TIMEOUT_SECONDS=60

# Optional full QQ messaging interfaces. Independent of the read-only Reader.
# Configure a separate SnowLuma loopback HTTP server before enabling.
QQ_MESSAGING_ENABLED=false
QQ_SEND_ENABLED=false
# Independent local API credential, at least 32 random printable characters.
QQ_MESSAGING_API_TOKEN=
QQ_ACTION_URL=http://127.0.0.1:3002
QQ_ACTION_TOKEN=
QQ_ACTION_TIMEOUT_SECONDS=60
QQ_MESSAGING_DB_PATH=data/qq/messaging.db
QQ_MESSAGING_MEDIA_DIR=data/qq/messaging-media
QQ_MESSAGING_IMAGE_MAX_BYTES=20971520
QQ_MESSAGING_VIDEO_MAX_BYTES=209715200
QQ_MESSAGING_MEDIA_MAX_BYTES=2147483648
QQ_MESSAGING_MESSAGE_MAX=100000

# Optional group names via an already-paired SnowLuma WebUI (loopback only).
# Credentials stay in a private local JSON file; the page only receives names.
QQ_METADATA_URL=
QQ_METADATA_CREDENTIAL_PATH=
